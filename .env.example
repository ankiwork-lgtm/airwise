# Local secrets - gitignored.
ANTHROPIC_API_KEY=sk-

# IBM ICA gateway base URL (read by @ai-sdk/anthropic as ANTHROPIC_BASE_URL).
# The provider appends /messages automatically, so this must end at the path
# prefix before /messages, e.g. /v1 → final call hits /v1/messages.
ANTHROPIC_BASE_URL=https://api.servicesessentials.ibm.com/v1

LLM_MODEL=claude-haiku-5-5
