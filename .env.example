# Template only - copy this file to .env (which is gitignored) and fill in
# your values. Never commit real keys.
ANTHROPIC_API_KEY=sk-

# Base URL of the Anthropic Messages API. AirWise appends /messages itself
# (airwise/services/llm.py), so the value must end before /messages,
# e.g. https://api.servicesessentials.ibm.com/v1
ANTHROPIC_BASE_URL=https://api.servicesessentials.ibm.com/v1

LLM_MODEL=claude-haiku-5-5
